# Copy to .env.local and fill in. Never commit .env.local.
# See HANDOVER.md for which society account owns each of these.

# Postgres. Neon (Vercel Marketplace) in production — use the pooled connection
# string. For local development, any Postgres will do.
DATABASE_URL="postgresql://user:password@localhost:5432/urdusoc"

# Auth.js session signing secret. Generate one with: npx auth secret
AUTH_SECRET=""

# Resend — sends committee magic links, RSVP confirmations and the mailing list.
#
# BOTH are optional, and email is only switched on when both are set. Without
# them the site serves every public page normally: membership signups and event
# RSVPs still work (the booking reference is shown on screen), the mailing-list
# opt-in is hidden, and no message is sent.
#
# The exception is committee sign-in, which *is* an email — /admin cannot be
# reached until these are set.
#
# Locally, leave them blank: messages, including your own sign-in link, are
# printed to the terminal running `npm run dev`.
RESEND_API_KEY=""
EMAIL_FROM="UrduSoc <hello@urdusoc.example>"

# Vercel Blob — stores gallery photographs uploaded through /admin/gallery.
# Optional: without it the whole site still runs and albums fall back to their
# CSS motif; only the photo uploader is switched off. Create a Blob store in the
# Vercel dashboard and it sets this for you.
BLOB_READ_WRITE_TOKEN=""

# Public origin. Set automatically on Vercel; only needed locally.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Only read by `npm run db:seed` — the first committee address allowed to sign in.
SEED_ADMIN_EMAIL=""
