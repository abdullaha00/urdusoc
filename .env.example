# Copy to .env.local and fill in. Never commit .env.local.
#
# Which society account owns each of these is recorded in the committee's
# private notes, not in this repository - ask the outgoing webmaster.

# Postgres. Neon (Vercel Marketplace) in production - use the pooled connection
# string. For local development, any Postgres will do.
DATABASE_URL="postgresql://user:password@localhost:5432/urdusoc"

# Auth.js session signing secret. Generate one with: npx auth secret
AUTH_SECRET=""

# Raven - committee sign-in. Required to reach /admin, in development too.
#
# Raven is OIDC over Google: UIS run it as a Google Workspace domain, so this is
# an ordinary Google OAuth client restricted to cam.ac.uk.
# https://docs.raven.cam.ac.uk/en/latest/creating-oauth2-client-credentials/
#
# Create it at https://console.cloud.google.com - Credentials → Create
# credentials → OAuth client ID → Web application. Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your domain>/api/auth/callback/google
#
# UIS reserve the cam.ac.uk Google Cloud organisation for official University
# sites; a student society registers under an ordinary Google account instead.
# Make that a society role account, NOT a committee member's personal one - this
# client is the keys to /admin, and whoever owns it must still be here next year.
# If it is ever lost, the way back in is SEED_ADMIN_EMAIL + `npm run db:seed`.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend - sends RSVP confirmations and the mailing list. Not sign-in: that is
# Raven, above.
#
# BOTH are optional, and email is only switched on when both are set. Without
# them the site serves every public page normally: membership signups and event
# RSVPs still work (the booking reference is shown on screen), the mailing-list
# opt-in is hidden, and no message is sent.
#
# Locally, leave them blank: messages are printed to the terminal running
# `npm run dev`.
#
# Spell the society out in the EMAIL_FROM display name - it is what a recipient
# reads in their inbox before opening anything, and the subject line is too
# short to carry the full name as well.
RESEND_API_KEY=""
EMAIL_FROM="Cambridge University Urdu Society <hello@urdusoc.example>"

# Vercel Blob. Server-side scripts can use project-scoped OIDC with
# BLOB_STORE_ID plus the short-lived VERCEL_OIDC_TOKEN written by `vercel link`
# or `vercel env pull`. The same credentials provide browser uploads through
# short-lived presigned URLs. BLOB_WEBHOOK_PUBLIC_KEY is supplied by the store
# connection and verifies that flow. The long-lived token is an optional
# fallback.
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""
BLOB_READ_WRITE_TOKEN=""

# Events spreadsheet - the source of truth for what is on /events.
#
# When these three are set, events are written in a Google Sheet and copied
# into the site once a day. /admin/events becomes a read-only view
# with a "Sync now" button. When they are unset the site behaves as it always
# did and events are edited by hand in /admin.
#
# Setting it up, once, per society (not per committee):
#
#  1. Create the sheet. `npm run sheet:headers` prints the heading row - paste
#     it into cell A1 and Google splits it across the columns. Only Title,
#     Summary and Date are compulsory, though Date may contain TBC; the README
#     lists the columns you can add later and warns about the one you must not
#     remove (Published).
#  2. In https://console.cloud.google.com, pick the same project as the Raven
#     OAuth client above. Enable the "Google Sheets API".
#  3. IAM & Admin → Service Accounts → Create service account. No roles are
#     needed: it gets its access from the sheet being shared with it, not from
#     the project. Then Keys → Add key → JSON.
#  4. Share the sheet with the service account's address as **Viewer**. This is
#     the step people forget; without it every sync fails with a 403.
#  5. Fill in the three variables below from the downloaded JSON.
#
# The service account is read-only (`spreadsheets.readonly`), so a leaked key
# cannot be used to alter the committee's spreadsheet.
#
# The id is the long string in the sheet's URL, between /d/ and /edit - not the
# whole URL.
EVENTS_SHEET_ID=""
# "client_email" from the JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# "private_key" from the JSON key file, in full, including the BEGIN and END
# lines. Keep it on one line with literal \n where the newlines were - that is
# how it appears in the JSON, and how the Vercel dashboard wants it.
GOOGLE_SERVICE_ACCOUNT_KEY=""
# Which tab and columns to read. The default suits a tab named "Events".
EVENTS_SHEET_RANGE="Events!A:V"

# Protects /api/cron/sync-events, which is otherwise a public URL that triggers
# a sync. Vercel sets this for you when the cron job in vercel.json is picked
# up; the route refuses every request while it is unset. Locally you do not
# need it - use the button in /admin/events, or `npm run sheet:sync`.
CRON_SECRET=""

# Public origin. Set automatically on Vercel; only needed locally.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Only read by `npm run db:seed` - the first committee address allowed to sign
# in. Must be a University address (crsid@cam.ac.uk), since sign-in is Raven.
SEED_ADMIN_EMAIL=""
